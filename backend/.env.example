# backend/.env.example — 플레이스홀더만 커밋한다. 실제 값이 든 .env는 절대 커밋하지 않는다
# (CLAUDE.md §7). 이 파일을 `.env`로 복사해 값을 채워 쓴다.

# --- 필수 ---
# docker-compose로 띄운 MySQL을 쓸 때(호스트에서 uvicorn 실행):
DATABASE_URL=mysql+pymysql://newsbrief:CHANGE_ME@localhost:3306/news_ai?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0

# --- 앱 ---
# 프런트 헤더의 "API {버전}" 표시에 그대로 쓰인다. CI 빌드/배포 시 주입한다.
# 예: API_VERSION=$(git rev-parse --short HEAD)
API_VERSION=dev
DEBUG=false

# --- CORS ---
# 같은 도메인에서 nginx로 서빙하면 비워 둔다(동일 출처라 불필요).
# Vite 개발 서버에서 직접 호출할 때만 채운다. allow_credentials=True이므로 와일드카드는 불가.
CORS_ORIGINS=["http://localhost:5173"]

# --- 세션 ---
SESSION_TTL_SECONDS=604800
# 로컬 http 개발에서는 false여야 브라우저가 쿠키를 저장한다. 배포에서는 반드시 true.
SESSION_COOKIE_SECURE=false

# --- 배치 스케줄러 ---
# 기본은 꺼짐. 켜면 앱을 띄우는 것만으로 07:30/12:30/17:30에 큐레이션·보관 배치가 돈다.
# 보관 배치는 되돌릴 수 없는 삭제(hard delete)를 하므로 개발 중에는 켜지 않는 편이 안전하다.
SCHEDULER_ENABLED=false

# A+B 수집·요약 파이프라인을 깨울 엔드포인트. A가 경로를 확정하면 채운다.
# 비어 있으면 수집 트리거 단계를 건너뛴다.
# COLLECT_TRIGGER_URL=http://127.0.0.1:8000/internal/batch/collect

# 수집·요약이 끝나기를 기다리는 오프셋(분). 07:00 슬롯이면 07:30에 C 배치가 돈다.
# 슬롯당 21개 카테고리 × 약 20초 = 약 7분이라 30분이면 충분하다.
CURATE_OFFSET_MINUTES=30

# --- 수집 (app/batch/collect.py) ---
# newscollect 경로. 비어 있으면 수집 배치를 건너뛴다.
# 수집기는 CLI만 있고 HTTP 서버가 없어서 서브프로세스로 부른다.
# COLLECT_ROOT=/absolute/path/to/newscollect

# 수집기를 돌릴 파이썬. 비우면 {COLLECT_ROOT}/.venv/bin/python 을 쓴다.
# 백엔드 venv와 다르다 — 수집기는 torch/sentence-transformers를 쓴다.
# COLLECT_PYTHON=

# 현재 freenews 단독이다. 63개 topic이 그대로 tags.slug와 일치한다 (CLAUDE.md §8-16).
COLLECT_PROVIDER=freenews

# 카테고리당 수집 건수. 63개 ÷ 3슬롯 × 2건 = 하루 126건.
# 3으로 올리면 Groq 하루 한도(200k)를 넘는다.
COLLECT_DISPLAY=2
COLLECT_LANGUAGE=en
COLLECT_TIMEOUT_SECONDS=300

# --- Groq 예산 ---
# 하루 토큰 한도. 초과하면 남은 카테고리를 건너뛴다.
GROQ_DAILY_TOKEN_BUDGET=200000
# 기사 1건 요약의 토큰 추정치(실측 802~1,003 + max_tokens 상향 여유).
# 수집기가 usage를 버려서 실측 누적이 불가능하다 — B가 usage를 반환하면 이 값은 없어진다.
GROQ_TOKENS_PER_ARTICLE=1200
