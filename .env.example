# 루트 .env.example — docker-compose.yml이 읽는 값이다.
# `cp .env.example .env` 후 값을 채운다. `.env`는 커밋하지 않는다 (CLAUDE.md §7).
#
# 백엔드 애플리케이션 설정은 별도다 → backend/.env.example
# 프런트엔드 빌드 설정도 별도다 → frontend/.env.example

# --- MySQL (필수: 값이 없으면 docker compose가 기동을 거부한다) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_PASSWORD=CHANGE_ME_app
MYSQL_USER=newsbrief
MYSQL_DATABASE=news_ai
MYSQL_PORT=3306

# --- Redis ---
REDIS_PORT=6379

# --- API 컨테이너 ---
API_PORT=8000
API_VERSION=dev
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]
SESSION_COOKIE_SECURE=false
