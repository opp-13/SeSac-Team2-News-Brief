# docker-compose.yml이 읽는 값들. `.env`로 복사해서 채운다 (실제 값은 커밋하지 않는다).
#
#   cp .env.compose.example .env

DOCKERHUB_USERNAME=opp13
IMAGE_TAG=latest

MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_NAME=news_ai
DB_USER=newsbrief
DB_PASSWORD=CHANGE_ME

# newscollect (뉴스 수집기)가 쓰는 외부 API 키
FREENEWS_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
GOOGLE_TRANSLATE_API_KEY=CHANGE_ME
NCP_CLIENT_ID=CHANGE_ME
NCP_CLIENT_SECRET=CHANGE_ME
