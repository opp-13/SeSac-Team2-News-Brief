# frontend/CLAUDE.md §6 — api/client.ts의 BASE 상수와 일치시킬 것
VITE_API_BASE_URL=/api/v1

# CI/CD 배포 검증용. src/utils/buildInfo.ts 가 이 값을 읽어
# components/common/Header.tsx 에 "Front {값}"으로 표시한다.
#
# 값은 배포된 커밋 SHA다. CI 빌드 단계에서 주입한다 — `npm run build:ci`
# (package.json 의 build:ci 스크립트가 git rev-parse --short HEAD 를 넣는다).
# 인라인으로 준 VITE_* 값이 .env 파일 값보다 우선하므로, 로컬에 .env 를 두더라도
# CI 빌드에는 영향이 없다.
#
# 값이 없으면(로컬 개발, .git 없는 컨테이너 빌드 등) 'dev'로 표시된다.
# 참고: package.json 의 version 필드는 화면에 표시되지 않는다.
VITE_APP_VERSION=dev
