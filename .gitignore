# 루트 .gitignore — 리포에 없어서 추가했다. 특히 .env 규칙이 없으면 시크릿이
# 실수로 커밋된다 (CLAUDE.md §7: .env는 gitignore, .env.example만 커밋).
# frontend/.gitignore, newscollect/.gitignore는 각 디렉토리 규칙을 따로 갖는다.

# --- 시크릿 ---
.env
.env.local
.env.*.local
!.env.example

# --- Node ---
# frontend/.gitignore가 프런트 브랜치에만 있어서, 다른 브랜치를 체크아웃하면
# node_modules가 untracked로 노출된다. 루트에서도 막아 둔다.
node_modules/
dist/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- 로그·임시 ---
*.log

# --- OS / 에디터 ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
